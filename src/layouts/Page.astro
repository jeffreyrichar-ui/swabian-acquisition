---
import Base from "./Base.astro";
import Faq from "@/components/Faq.astro";
import Topo from "@/components/Topo.astro";
import { getPage, type PageKey } from "@/data/pages";
import { entity } from "@/lib/entity";
import { graph, organization, person, website, webPage, breadcrumbs, faqPage } from "@/lib/schema";
import { getEntry } from "astro:content";

interface Props { pageKey: PageKey }
const { pageKey } = Astro.props;
const page = getPage(pageKey);
const canonical = new URL(page.path, entity.url).href;
const title = pageKey === "home"
  ? `${entity.name} | ${page.title}`
  : `${page.title} | ${entity.name}`;

let faqItems: { question: string; answer: string }[] = [];
if (page.faq) {
  const entry = await getEntry("faq", page.faq);
  faqItems = entry?.data.items ?? [];
}

const nodes = graph([
  organization(), person(), website(), webPage(page),
  breadcrumbs(page), faqPage(faqItems),
]);
---
<Base {title} description={page.description} {canonical} graph={nodes}>
  {pageKey === "home" ? (
    <>
      <div class="hero">
        <div class="wrap hero-inner">
          <div class="hero-copy">
            <p class="eyebrow">Boise, Idaho</p>
            <h1 set:html={page.h1Accent
              ? page.h1.replace(page.h1Accent, `<span class="it">${page.h1Accent}</span>`)
              : page.h1} />
            <slot name="answer" />
            <p class="hero-actions">
              <a class="cta" href={`tel:${entity.contact.telephone}`}>Call {entity.contact.telephone_display}</a>
              <a class="cta-ghost" href="/what-we-buy/">What we buy</a>
            </p>
          </div>
          <Topo />
        </div>
      </div>
      <div class="wrap">
        <div class="body">
          <slot />
          <Faq items={faqItems} />
        </div>
      </div>
    </>
  ) : (
    <div class="wrap">
      <div class="body">
        <p class="eyebrow">{page.navLabel ?? page.title}</p>
        <h1>{page.h1}</h1>
        <slot />
        <Faq items={faqItems} />
      </div>
    </div>
  )}
  {pageKey !== "contact" && (
    <div class="wrap">
      <aside class="page-close">
        <div>
          <p class="micro">Talk to the buyer</p>
          <p class="page-close-line">One conversation. Thirty minutes, confidential, no documents.</p>
        </div>
        <p class="page-close-actions">
          <a class="cta" href={`tel:${entity.contact.telephone}`}>{entity.contact.telephone_display}</a>
          <a class="cta-ghost" href="/contact/">Write instead</a>
        </p>
      </aside>
    </div>
  )}
</Base>
