---
/**
 * Three fields, a honeypot, and a three second gate. No CAPTCHA: this form is
 * for a 63 year old owner on a phone, and every point of friction costs a
 * conversation. Falls back to a plain POST without JavaScript, and renders
 * mail and phone links only until Jeff supplies the endpoint.
 */
import { entity, formLive, mailHref, phoneHref } from "@/lib/entity";
const endpoint = entity.contact.form.endpoint;
---
{formLive ? (
  <form class="contact" id="contact-form" action={endpoint} method="POST">
    <label>
      Your name
      <input type="text" name="name" required autocomplete="name" />
    </label>
    <label>
      Email or phone, whichever you prefer
      <input type="text" name="reply_to" required autocomplete="email" />
    </label>
    <label>
      What would you like to talk about?
      <textarea name="message" required minlength="20"></textarea>
    </label>
    <div class="hp" aria-hidden="true">
      <label>Leave this field empty<input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
    </div>
    <input type="hidden" name="_t" id="form-loaded-at" value="" />
    <button class="cta" type="submit">Send</button>
    <p class="formnote" id="form-status" role="status"></p>
  </form>
  <script is:inline>
    (function () {
      var form = document.getElementById("contact-form");
      if (!form) return;
      var loaded = Date.now();
      var stamp = document.getElementById("form-loaded-at");
      if (stamp) stamp.value = String(loaded);
      var status = document.getElementById("form-status");
      form.addEventListener("submit", function (event) {
        if (Date.now() - loaded < 3000) {
          event.preventDefault();
          if (status) status.textContent = "Please take a moment and try again.";
          return;
        }
        event.preventDefault();
        if (status) status.textContent = "Sending...";
        fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        }).then(function (r) {
          if (r.ok) {
            form.reset();
            if (status) status.textContent = "Thank you. I read every message myself and will reply personally.";
            if (window.plausible) window.plausible("Contact");
          } else if (status) {
            status.textContent = "That did not send. Please email or call instead.";
          }
        }).catch(function () {
          if (status) status.textContent = "That did not send. Please email or call instead.";
        });
      });
    })();
  </script>
) : (
  <p class="formnote">
    The form is not connected yet. Email <a href={mailHref}>{entity.contact.email}</a> or
    call <a href={phoneHref}>{entity.contact.telephone_display}</a>.
  </p>
)}
